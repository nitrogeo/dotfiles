{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  
  "logo": {
    "source": "arch",
    "color": {
                //"1": "magenta", // Primary Arch color to Mauve
                // "2": "magenta"  // Secondary Arch color to Mauve

                "1": "#cba6f7", // Primary Arch color to Mauve
                "2": "#8787d4"  // Secondary Arch color to Mauve
            }
  },

  "display": {
        // "color": "magenta" // This is the standard "Mauve" equivalent in many terminal themes
        "color": "#cba6f7" // hex = #cba6f7
    },

  "modules": [
    "title",
    "separator",
    {
        "type": "media",
        "key": "󰝚 Media", // Nerd Font Icon
        // "keyColor": "#cba6f7"
        "format": "{artist:20}... - {title} - {progress} ({progress-num}) [{status}]" // artist cut to 20 chars + "...", rest as before
    },
    


    "break",
    
    


    // ── Hardware ──
    {
        "type": "custom",
        "format": "󰘚 Hardware"
    },
    "host",
    "cpu",
    "memory",
    "swap",
    "gpu",
    "disk",
    "display",
    "battery",
    "poweradapter",


    "break",


    // ── Software ──
    {
        "type": "custom",
        "format": "󰣆 Software"
    },
    "os",
    "kernel",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "shell",
    "uptime",
    "packages",
    {
            "type": "localip",
            "key": "󰩟 Network",
            "keyColor": "magenta"
        },
    "localip",
    "locale",


    "break",
    "colors"
  ]
}
