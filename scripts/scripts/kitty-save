#!/usr/bin/env sh
OUTPUT_DIR="$HOME/Documents/console/kitty"
mkdir -p "$OUTPUT_DIR"

PARENT_ID=$(kitty @ ls | python3 -c "
import sys, json
data = json.load(sys.stdin)
overlay_ts = None
best_id = None
best_ts = -1
for os_window in data:
    for tab in os_window.get('tabs', []):
        for win in tab.get('windows', []):
            ts = win.get('last_focused_at', 0)
            if win.get('is_self'):
                overlay_ts = ts
            elif ts > best_ts:
                best_ts = ts
                best_id = win['id']
# Prefer the window focused just before the overlay
if overlay_ts and best_id:
    print(best_id)
" 2>/dev/null)

if [ -z "$PARENT_ID" ]; then
    echo "Error: Could not find parent window" >&2
    exit 1
fi

kitty @ get-text --match="id:$PARENT_ID" --extent=all --ansi \
  > /tmp/kitty_save_buffer.txt 2>/tmp/kitty_save_error.txt

if [ ! -s /tmp/kitty_save_buffer.txt ]; then
    echo "Warning: captured 0 bytes, check /tmp/kitty_save_error.txt" >&2
fi

printf 'Enter filename: '
read -r filename
final_name="${filename:-dump_$(date +%H%M%S)}"
mv /tmp/kitty_save_buffer.txt "${OUTPUT_DIR}/${final_name}.txt"

command -v notify-send >/dev/null 2>&1 && \
  notify-send 'Kitty Output Saved' "${final_name}.txt saved"
