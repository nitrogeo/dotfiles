#!/usr/bin/env sh
TO="unix:/tmp/mykitty"
OUTPUT_DIR="$HOME/Documents/console/kitty"
mkdir -p "$OUTPUT_DIR"

kitty @ --to "$TO" get-text --extent=all --match="state:parent_focused" --ansi \
  > /tmp/kitty_save_buffer.txt 2>/tmp/kitty_save_error.txt

printf 'Enter filename: '
read -r filename
final_name="${filename:-dump_$(date +%H%M%S)}"
mv /tmp/kitty_save_buffer.txt "${OUTPUT_DIR}/${final_name}.txt"

command -v notify-send >/dev/null 2>&1 && \
  notify-send 'Kitty Output Saved' "${final_name}.txt saved"
