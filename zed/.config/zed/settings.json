// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "unified",
  "languages": {
    "Markdown": {
      "show_edit_predictions": false
    }
  },
  "remove_trailing_whitespace_on_save": false,
  "ssh_connections": [
    {
      "host": "nebulon",
      "args": [],
      "projects": [
        {
          "paths": ["/home/nitro"],
        },
        {
          "paths": ["/home/nitro/hoth"],
        },
      ],
    },
  ],
  "tab_bar": {
    "show": true,
  },
  "minimap": {
    "show": "always",
    "thumb_border": "left_open",
    "current_line_highlight": "all",
    "max_width_columns": 65,
  },
  "preview_tabs": {
    "enable_preview_from_project_panel": false,
    "enabled": false,
  },
  "search": {
    "button": true,
  },
  "bottom_dock_layout": "contained",
  "debugger": {
    "button": true,
  },
  "diagnostics": {
    "button": true,
  },
  "ui_font_family": ".ZedSans",
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "opencode": {
      "type": "registry",
      "favorite_config_option_values": {
        "model": [
          "opencode/deepseek-v4-flash-free",
          "opencode/nemotron-3-ultra-free",
        ],
      },
    },
  },
  "buffer_line_height": "standard",
  "calls": {
    "mute_on_join": true,
  },
  "proxy": "",
  "tabs": {
    "show_close_button": "hover",
    "activate_on_close": "left_neighbour",
    "show_diagnostics": "all",
    "file_icons": true,
    "git_status": true,
  },
  "title_bar": {
    "button_layout": "platform_default",
    "show_menus": false,
    "show_user_menu": true,
    "show_sign_in": true,
    "show_branch_name": true,
    "show_branch_status_icon": true,
  },
  "status_bar": {
    "line_endings_button": true,
    "active_encoding_button": "enabled",
    "active_language_button": true,
    "show_active_file": true,
  },
  "restore_on_startup": "last_workspace",
  "project_panel": {
    "hide_hidden": false,
    "button": true,
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "when_closing_with_no_tabs": "keep_window_open",
  "icon_theme": {
    "mode": "light",
    "light": "Seti Icon Theme",
    "dark": "Seti Icon Theme",
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "base_keymap": "VSCode",
  "cursor_shape": "underline",
  "cursor_blink": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "buffer_font_family": "CommitMono Nerd Font Mono",
  "ui_font_size": 14.0,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Duskfox - blurred",
  },
}
